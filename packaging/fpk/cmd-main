#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
HEALTH_URL="http://127.0.0.1:5111/healthz"

APP_DIR="${TRIM_APPDEST}/app/homeledger"
NODE_BIN="${TRIM_APPDEST}/app/runtime/node"

# 启动命令：内置 Node 运行时 + 数据写入应用专属 var 目录
CMD="env PORT=5111 HOST=0.0.0.0 DATA_DIR=${TRIM_PKGVAR}/data TZ=Asia/Shanghai \"${NODE_BIN}\" --no-warnings \"${APP_DIR}/server.js\""

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

ensure_executable() {
    # Windows 打包可能丢失可执行位，启动前自愈
    if [ ! -x "${NODE_BIN}" ]; then
        chmod +x "${NODE_BIN}" 2>/dev/null || log_msg "WARN: chmod +x node 失败（owner 非当前用户）"
    fi
    chmod +x "${APP_DIR}/server.js" 2>/dev/null || true
    find "${APP_DIR}/src" -name "*.js" ! -perm -u+x -exec chmod +x {} + 2>/dev/null || true
}

health() {
    if command -v curl >/dev/null 2>&1; then
        curl -sf -o /dev/null --max-time 3 "${HEALTH_URL}"
        return $?
    fi
    "${NODE_BIN}" -e "fetch('${HEALTH_URL}').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null
}

start_process() {
    if status; then
        return 0
    fi

    ensure_executable
    mkdir -p "${TRIM_PKGVAR}/data"

    log_msg "Starting process ... (node: $(${NODE_BIN} -v 2>&1 || echo 'WARN: node 无法执行'))"
    cd "${APP_DIR}" || return 1
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    # write pid to pidfile
    printf "%s" "$!" > ${PID_FILE}
    # log_msg "CMD = ${CMD}"
    # log_msg "pid = $!"

    # 等待健康检查就绪（最多 15 秒）
    count=0
    while [ $count -lt 15 ]; do
        sleep 1
        count=$((count + 1))
        if health; then
            log_msg "process ready (healthz ok, ${count}s)"
            return 0
        fi
        if ! status; then
            log_msg "ERROR: process exited during startup, recent log:"
            tail -n 20 "${LOG_FILE}" > "${TRIM_PKGVAR}/.recent.log" 2>/dev/null || true
            cat "${TRIM_PKGVAR}/.recent.log" >> "${LOG_FILE}" 2>/dev/null || true
            rm -f "${TRIM_PKGVAR}/.recent.log"
            return 1
        fi
    done
    log_msg "WARN: process alive but healthz not ready after ${count}s"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
