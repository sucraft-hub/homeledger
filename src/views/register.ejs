<h1 style="font-size:18px;margin-bottom:6px">创建账号</h1>
<p class="muted small mb16">注册后会自动为你创建一个默认账本</p>

<% if (error) { %>
  <div class="flash error"><span><%= error %></span></div>
<% } %>

<form method="post" action="/register">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field">
    <label>用户名</label>
    <input type="text" name="username" value="<%= form.username || '' %>" required autofocus>
    <div class="help">3–32 位，字母、数字、下划线、点、@ 或短横线</div>
  </div>
  <div class="field">
    <label>昵称</label>
    <input type="text" name="display_name" value="<%= form.display_name || '' %>" placeholder="例如：老王">
  </div>
  <div class="field">
    <label>密码</label>
    <input type="password" name="password" autocomplete="new-password" required>
    <div class="help">至少 6 位</div>
  </div>
  <div class="field">
    <label>确认密码</label>
    <input type="password" name="password2" autocomplete="new-password" required>
  </div>
  <button class="btn btn-primary btn-block btn-lg" type="submit">注册并开始记账</button>
</form>

<div class="auth-foot">已有账号？<a href="/login">直接登录</a></div>
